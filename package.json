{
  "name": "primo-cli",
  "version": "0.2.0",
  "description": "Local development CLI for Primo",
  "type": "module",
  "bin": {
    "primo": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm test",
    "postinstall": "node scripts/postinstall.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primocms/primo-cli.git"
  },
  "homepage": "https://primo.build",
  "bugs": {
    "url": "https://github.com/primocms/primo-cli/issues"
  },
  "keywords": [
    "primo",
    "cms",
    "svelte",
    "static-site",
    "cli"
  ],
  "author": "Primo",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "esbuild": "^0.27.4",
    "extract-zip": "^2.0.1",
    "inquirer": "^13.3.0",
    "js-yaml": "^4.1.0",
    "ora": "^8.0.1",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "primo-mcp": "^0.1.8",
    "svelte": "^5.55.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
